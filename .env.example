# Environment Configuration
NODE_ENV=development
PORT=5000

# MongoDB Configuration
# Note: For production and replica-set testing, use a connection string with replicaSet parameter
MONGODB_URI=mongodb://localhost:27017/chittagong_auto_parts

# JWT Authentication
JWT_SECRET=super_secret_jwt_key_chittagong_auto_parts_2026_min_32_chars
JWT_EXPIRES_IN=7d

# CORS Allowed Origin (comma-separated if multiple or *)
CLIENT_ORIGIN=http://localhost:3000,http://localhost:5173

# Initial Bootstrap Administrator Credentials (created automatically on first launch if absent)
BOOTSTRAP_ADMIN_NAME="System Administrator"
BOOTSTRAP_ADMIN_PHONE="01811000000"
BOOTSTRAP_ADMIN_PASSWORD="AdminPassword123!"

# Default Business Timezone
APP_TIMEZONE=Asia/Dhaka

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10
